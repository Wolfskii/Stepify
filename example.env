# Copy this file to `.env` in the project root and fill in values.
# `.env` is gitignored; this file is the template to commit.
#
# Spotify — optional metadata search (Client Credentials).
# Create an app at https://developer.spotify.com/dashboard
# End users do not log in; only these app credentials are used for catalog search.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
